# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=false @defaultSensitive=false
# @plugin(@varlock/bitwarden-plugin@1.0.0)
# @initBitwarden(accessToken=$BWS_ACCESS_TOKEN)
# ----------

# Bitwarden bootstrap token supplied by shell/CI
# @required @sensitive @type=bitwardenAccessToken
BWS_ACCESS_TOKEN=

# AI provider
# @required @sensitive
AI_API_KEY=bitwarden("059526f9-7b72-42b3-9b44-b442007c41aa")

# Optional: separate key for image generation (defaults to AI_API_KEY)
# @sensitive
AI_IMAGE_KEY=

# Git sync
# @required @sensitive
GIT_SYNC_TOKEN=bitwarden("f1a510e0-4b81-47bb-9e08-b442007c4204")

# Interfaces
# @sensitive
DISCORD_BOT_TOKEN=bitwarden("be90ce2f-4674-4ae5-9f3f-b442007c42c5")

# LinkedIn
# @sensitive
LINKEDIN_ACCESS_TOKEN=

# @sensitive
LINKEDIN_ORGANIZATION_ID=

# Cloudflare analytics
# @sensitive
CLOUDFLARE_ACCOUNT_ID=

# @sensitive
CLOUDFLARE_API_TOKEN=

CLOUDFLARE_ANALYTICS_SITE_TAG=

# ---- deploy/provision vars (written by brain init --deploy) ----

# @required @sensitive
HCLOUD_TOKEN=bitwarden("c0c98f85-e95c-4057-8623-b442007c4322")

# @required
HCLOUD_SSH_KEY_NAME=bitwarden("b773e835-0453-465f-972f-b442007c4383")

# @required
HCLOUD_SERVER_TYPE=bitwarden("79e5797b-fb96-4a5a-a676-b442007c43e4")

# @required
HCLOUD_LOCATION=bitwarden("bdfc7584-1550-49a2-bcf9-b442007c4440")

# @required @sensitive
KAMAL_SSH_PRIVATE_KEY=bitwarden("abb5cf8d-579a-4e33-8c81-b442007c44b3")

# @required @sensitive
KAMAL_REGISTRY_PASSWORD=bitwarden("662710f9-e81d-4fd6-a115-b442007c4510")

# @required @sensitive
CF_API_TOKEN=bitwarden("e90790d2-ccd0-49df-a0b3-b442007c458a")

# @required
CF_ZONE_ID=bitwarden("94c91d82-47d1-49ec-9243-b442007c45ee")

# ---- TLS cert vars (written by brain cert:bootstrap, consumed by kamal-proxy) ----

# @required @sensitive
CERTIFICATE_PEM=bitwarden("e0ee82e7-79a5-4d41-a1b3-b442007c4662")

# @required @sensitive
PRIVATE_KEY_PEM=bitwarden("f98fc54d-c5da-4557-a1c9-b442007c46bf")
